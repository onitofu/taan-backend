POSTGRES_PASSWORD=
POSTGRES_HOSTNAME=127.0.0.1
POSTGRES_PORT=5432

BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_HOSTNAME=127.0.0.1
BACKEND_PORT=2181

DB_HOSTNAME=postgres
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=5
DB_SOCKET_TIMEOUT_SECONDS=5

BACKEND_MAX_CONNECTIONS=128
BACKEND_MAX_FRAME_BYTES=16384
BACKEND_MAX_PENDING_REQUESTS=8
BACKEND_AUTH_WORKER_THREADS=2
BACKEND_AUTH_QUEUE_CAPACITY=64
BACKEND_DATABASE_WORKER_THREADS=2
BACKEND_DATABASE_QUEUE_CAPACITY=128
BACKEND_REQUEST_WORKER_THREADS=2
BACKEND_REQUEST_QUEUE_CAPACITY=128
BACKEND_SETTLEMENT_WORKER_THREADS=1
BACKEND_SETTLEMENT_QUEUE_CAPACITY=64
DB_POOL_SIZE=6
DB_ACQUIRE_TIMEOUT_MILLIS=1000
BACKEND_MATCH_COMMAND_QUANTUM=32
BACKEND_REQUEST_TIMEOUT_SECONDS=10
BACKEND_FRAME_ASSEMBLY_TIMEOUT_SECONDS=10
BACKEND_IDLE_TIMEOUT_SECONDS=300
BACKEND_SHUTDOWN_TIMEOUT_SECONDS=20

ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

LOG_LEVEL=INFO
LOG_WARN_BURST=10
LOG_WARN_INTERVAL_SECONDS=60

BACKEND_MAX_PENDING_OUTPUT_BATCHES=64
BACKEND_MAX_PENDING_OUTPUT_BYTES=1048576
BACKEND_PLAYABLE_TIME_BOOTSTRAP_SECONDS=3600

BACKEND_MATCH_LOADING_TIMEOUT_SECONDS=30
BACKEND_MATCH_PREVIEW_TIMEOUT_SECONDS=20
BACKEND_MATCH_REPORTS_PER_SECOND=8
BACKEND_MATCH_WORKER_THREADS=2
BACKEND_MATCH_QUEUE_CAPACITY=64
BACKEND_MATCH_ACTION_TIMEOUT_SECONDS=20
